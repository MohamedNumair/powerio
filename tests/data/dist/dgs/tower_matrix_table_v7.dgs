********************************************************************************
* Hand-authored DGS 7.0 fixture, original to this repository: the same coupled
* section as tower_4wire_v7.dgs but with the phase matrices carried in the
* NORMALIZED `$$Matrix` table (FID;MatRow;MatColumn;Val) that the type row
* references by FID, per the DGS 7.0 vector/matrix normalisation.
* A strictly lower-triangular X_c1 checks symmetric completion.
********************************************************************************

$$General;FID(a:40);Descr(a:40);Val(a:40)
1;Version;7.0


$$ElmNet;FID(a:40);OP(a:1);loc_name(a:40);fold_id(p);frnom(r)
Grid;C;FourWireNorm;;50


$$ElmTerm;FID(a:40);OP(a:1);loc_name(a:40);fold_id(p);iUsage(i);outserv(i);uknom(r)
A;C;A;Grid;0;0;0.4
B;C;B;Grid;0;0;0.4


$$ElmXnet;FID(a:40);OP(a:1);loc_name(a:40);fold_id(p);bustp(a:2);usetp(r)
Ext;C;Ext;Grid;SL;1


$$TypTow;FID(a:40);OP(a:1);loc_name(a:40);fold_id(p);R_c1(a:40);X_c1(a:40)
Tow1;C;Tower 4w;Types;RMAT1;XMAT1


$$Matrix;FID(a:40);MatRow(i);MatColumn(i);Val(d)
RMAT1;0;0;0.11
RMAT1;0;1;0.031
RMAT1;0;2;0.032
RMAT1;0;3;0.041
RMAT1;1;0;0.031
RMAT1;1;1;0.12
RMAT1;1;2;0.033
RMAT1;1;3;0.042
RMAT1;2;0;0.032
RMAT1;2;1;0.033
RMAT1;2;2;0.13
RMAT1;2;3;0.043
RMAT1;3;0;0.041
RMAT1;3;1;0.042
RMAT1;3;2;0.043
RMAT1;3;3;0.25
XMAT1;0;0;0.21
XMAT1;1;0;0.09
XMAT1;1;1;0.22
XMAT1;2;0;0.07
XMAT1;2;1;0.08
XMAT1;2;2;0.23
XMAT1;3;0;0.06
XMAT1;3;1;0.061
XMAT1;3;2;0.062
XMAT1;3;3;0.4


$$ElmLne;FID(a:40);OP(a:1);loc_name(a:40);fold_id(p);typ_id(p);dline(r);fline(r);nlnum(i);outserv(i)
LnT;C;LnT;Grid;Tow1;1;1;1;0


$$StaCubic;FID(a:40);OP(a:1);loc_name(a:40);fold_id(p);obj_bus(i);obj_id(p)
CubX;C;CubX;A;0;Ext
Cub0;C;Cub0;A;0;LnT
Cub1;C;Cub1;B;1;LnT
